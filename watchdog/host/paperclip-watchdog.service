[Unit]
Description=Paperclip watchdog: clears quarantines, unblocks stalled tasks, relays CI results
Documentation=file://%h/.local/lib/paperclip-watchdog/watchdog.mjs

[Service]
Type=oneshot
# nvm puts node on PATH (if installed); ~/.local/bin has claude and the restart command.
ExecStart=/bin/bash -c 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null; export PATH="$HOME/.local/bin:$HOME/.local/share/pnpm/bin:$PATH"; exec node "$HOME/.local/lib/paperclip-watchdog/watchdog.mjs"'
TimeoutStartSec=600
Nice=10
