[Unit]
Description=Token Lens collector: tool calls per run and merged-commit lines for the Token Lens plugin
Documentation=file://%h/projects/paperclip-plugins/fleet-cost/collector/collect.mjs

[Service]
Type=oneshot
# Does nothing when Paperclip isn't answering; it never starts Paperclip.
# The collector's settings (TOKEN_LENS_REPOS, GH_CONFIG_DIR...), one VAR=value per line.
# TOKEN_LENS_DIR is this plugin's folder when it isn't ~/projects/paperclip-plugins/fleet-cost.
EnvironmentFile=-%h/.config/token-lens/env
ExecStart=/bin/bash -c 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null; cd "$${TOKEN_LENS_DIR:-$HOME/projects/paperclip-plugins/fleet-cost}" && exec node collector/collect.mjs'
TimeoutStartSec=900
Nice=10
